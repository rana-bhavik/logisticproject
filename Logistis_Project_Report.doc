<tr><td style="border: 1px solid #ddd; padding: 10px 8px; color: #444;">User</td><td style="border: 1px solid #ddd; padding: 10px 8px; color: #444;">Stores credentials & roles</td><td style="border: 1px solid #ddd; padding: 10px 8px; color: #444;">email, password, role, status</td><td style="border: 1px solid #ddd; padding: 10px 8px; color: #444;">Rana Shubham</td></tr>
