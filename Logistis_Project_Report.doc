<tr><td style="border: 1px solid #ddd; padding: 10px 8px; color: #444;">GET</td><td style="border: 1px solid #ddd; padding: 10px 8px; color: #444;"><code style="background-color: #f4f4f4; padding: 2px 4px; border-radius: 3px; font-family: Consolas;">/api/users</code></td><td style="border: 1px solid #ddd; padding: 10px 8px; color: #444;">Fetches all users (protected by auth middleware)</td><td style="border: 1px solid #ddd; padding: 10px 8px; color: #444;">Rana Shahil</td></tr>
